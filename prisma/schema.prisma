generator client {
  provider      = "prisma-client"
  output        = "./generated/prisma"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

generator prismabox {
  provider                    = "prismabox"
  output                      = "../generated/prismabox"
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id         String        @id @default(uuid())
  googleSub  String        @unique
  email      String        @unique
  name       String?
  avatarUrl  String?
  onboarding Boolean       @default(false)
  createdAt  DateTime      @default(now())
  fcmToken   String?
  groups     groupMember[]
  routines   routine[]
  stats      forgetStat[]
}

model routine {
  id              String        @id @default(uuid())
  name            String
  radius          Int           @default(50)
  triggerHour     Int?
  triggerMinute   Int?
  freeSpace       Int?
  locations       location[]
  street          String?
  streetNumber    String?
  createdAt       DateTime      @default(now())
  userId          String?
  groupId         String?
  triggerOnExit   Boolean       @default(false)
  activeDays      Json?
  timeframeEnd    String?
  timeframeStart  String?
  weeklyPlan      Json?
  group           group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            user?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           routineItem[]
  stats           forgetStat[]
  assignedUserIds Json          @default("[]")

  @@index([groupId], map: "routine_groupId_fkey")
  @@index([userId], map: "routine_userId_fkey")
}

model forgetStat {
  id          String  @id @default(uuid())
  at          String
  routineId   String
  userId      String
  routineName String
  itemId      String?
  itemName    String
  forgotten   Boolean
  weekday     Int
  minuteOfDay Int
  routine     routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user        user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, routineId, itemName, at])
  @@index([routineId], map: "forgetStat_routineId_fkey")
  @@index([userId, at], map: "forgetStat_userId_fkey")
}

model location {
  locationId String  @id @default(uuid())
  longitude  Float
  latitude   Float
  routineId  String
  routine    routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId], map: "routineLocation_routineId_fkey")
}

model routineItem {
  id          String    @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  routineId   String
  checkedAt   DateTime?
  checkedBy   String?
  // Weekdays this item is needed on (Date.getDay(): 0 = Sunday … 6 = Saturday).
  // null = every day.
  days        Json?
  routine     routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId], map: "routineItem_routineId_fkey")
}

model group {
  id              String        @id @default(uuid())
  name            String
  inviteCode      String        @unique @default(cuid())
  createdAt       DateTime      @default(now())
  createdByUserId String?
  members         groupMember[]
  routines        routine[]
}

model groupMember {
  id      String   @id @default(uuid())
  groupId String
  userId  String
  muted   Boolean?
  group   group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId], map: "groupMember_userId_fkey")
}
